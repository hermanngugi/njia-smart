SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed for Team > Create / Delete staff. Never expose it to the browser (no VITE_ prefix).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# QuickBooks Online OAuth — development sandbox only.
# Register this exact HTTPS callback URL in Intuit Developer > Development > Keys & OAuth.
# Keep both QBO credentials server-side; do not add VITE_ prefixes.
QBO_ENVIRONMENT=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://YOUR-VERCEL-PREVIEW-DOMAIN/api/integrations/qbo/callback
